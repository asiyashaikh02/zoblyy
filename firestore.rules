rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email == 'ilaeequrrahman@gmail.com')
      );
    }

    // Admins registry: readable by authenticated users to verify permissions, no client write
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Enrollments: Student registration records
    match /enrollments/{enrollmentId} {
      // Student can read only their own; Admin can read all
      allow read: if isAuthenticated() && (isAdmin() || resource.data.studentId == request.auth.uid);
      // Anyone can submit a student registration application / lead
      allow create: if request.resource.data.name is string &&
                       request.resource.data.email is string &&
                       request.resource.data.phone is string;
      // Admin can update status and adminNotes; Student cannot change status or adminNotes
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.studentId == request.auth.uid &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.adminNotes == resource.data.adminNotes
      );
      allow delete: if isAdmin();
    }

    // Admin notifications
    match /adminNotifications/{notifId} {
      // Allow registration trigger on enrollment submission
      allow create: if request.resource.data.type is string;
      // Only Admin can read, update, or clear notifications
      allow read, update, delete: if isAdmin();
    }

    // Users: Private user profiles
    match /users/{userId} {
      // Student can read ONLY their own /users/{uid} document; Admin can read all user documents
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());

      // Student can create their own profile ONLY with role == 'student' and matching uid.
      // Admin can create user profiles with any role.
      allow create: if (
        isOwner(userId) && 
        request.resource.data.role == 'student' && 
        request.resource.data.uid == userId
      ) || isAdmin();

      // Student can update their own profile ONLY if:
      // - uid is unchanged
      // - role is unchanged
      // - role remains 'student' (student can never self-promote to 'admin')
      // Admin can manage user documents as required.
      allow update: if (
        isOwner(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.role == 'student'
      ) || isAdmin();

      // Delete: Admin only
      allow delete: if isAdmin();
    }
    
    // Deprecated legacy collection: read isolated to owner/admin, writes strictly forbidden
    match /userProfiles/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if false;
    }

    // Resumes: Stored user resume metadata
    match /resumes/{resumeId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Projects: Proof-of-work project repositories
    match /projects/{projectId} {
      allow read: if true; // Public verified proof artifacts can be viewed by employers
      allow write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Career Plans: Private learning sprint roadmaps
    match /careerPlans/{planId} {
      allow read, write: if isAuthenticated() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // Interviews: Mock interviews and feedback transcripts
    match /interviews/{interviewId} {
      allow read, write: if isAuthenticated() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // Job Applications: Personal job pipeline tracker
    match /jobApplications/{appId} {
      allow read, write: if isAuthenticated() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // AI Generations: Secure backend generated evaluation transcripts
    match /aiGenerations/{genId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Immutable audit log
    }
  }
}
